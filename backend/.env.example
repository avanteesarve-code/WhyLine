# WhyLine backend configuration (all optional; defaults shown)

# Comma-separated Binance symbols to track. Defaults are 10 deep-liquidity
# majors chosen so sudden moves are visible and news-attributable.
#SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,LTCUSDT

# Candle interval and how many closed candles to backfill per symbol
#INTERVAL=1m
#HISTORY_LIMIT=1000

# Rolling z-score detector
#DETECT_WINDOW=60
#DETECT_MIN_PERIODS=30
#RETURN_Z_THRESHOLD=3.0
#VOLUME_Z_THRESHOLD=3.5
#ANOMALY_COOLDOWN=3

# Isolation Forest detector
#IFOREST_BUFFER=240
#IFOREST_MIN_BUFFER=180
#IFOREST_REFIT_EVERY=15
#IFOREST_CONTAMINATION=0.01

# Binance public market-data hosts (no API key needed).
# Fallbacks: https://api.binance.com and wss://stream.binance.com:9443
#BINANCE_REST_BASE=https://data-api.binance.vision
#BINANCE_WS_BASE=wss://data-stream.binance.vision

# Milestone B (semantic attribution) — not used yet
#NEWS_API_KEY=
