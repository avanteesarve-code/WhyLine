# WhyLine backend configuration (all optional; defaults shown)

# Comma-separated Binance symbols to track. Defaults are 10 deep-liquidity
# majors chosen so sudden moves are visible and news-attributable.
#SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,LTCUSDT

# Candle interval and how many closed candles to backfill per symbol
#INTERVAL=1m
#HISTORY_LIMIT=1000

# Rolling z-score detector
#DETECT_WINDOW=60
#DETECT_MIN_PERIODS=30
#RETURN_Z_THRESHOLD=3.0
#VOLUME_Z_THRESHOLD=3.5
#ANOMALY_COOLDOWN=3

# Isolation Forest detector
#IFOREST_BUFFER=240
#IFOREST_MIN_BUFFER=180
#IFOREST_REFIT_EVERY=15
#IFOREST_CONTAMINATION=0.01

# Binance public market-data hosts (no API key needed).
# Fallbacks: https://api.binance.com and wss://stream.binance.com:9443
#BINANCE_REST_BASE=https://data-api.binance.vision
#BINANCE_WS_BASE=wss://data-stream.binance.vision

# Milestone B (semantic attribution) — real crypto news via Finnhub
# (backend/news.py), wired into live anomalies in backend/main.py.
# FINNHUB_API_KEY is the Finnhub API token (https://finnhub.io/dashboard,
# free tier suffices: GET /api/v1/news?category=crypto, 60 calls/min).
# Never commit a real key to git; put it in backend/.env (gitignored) only.
FINNHUB_API_KEY=
#NEWS_API_KEY=  (legacy alias; FINNHUB_API_KEY takes precedence when both set)

# News provider knobs (defaults shown)
#NEWS_API_BASE=https://finnhub.io/api/v1
#NEWS_WINDOW_BEFORE=3600
#NEWS_WINDOW_AFTER=900
# Extended lookback (seconds) for real keyword-relevant articles when the
# strict window matches nothing; recency stays visible per-article.
#NEWS_RELAXED_WINDOW_BEFORE=86400
# Shared provider-response cache TTL (seconds) across symbols; 0 disables.
#NEWS_CACHE_TTL=120
#NEWS_MAX_ITEMS=5
#NEWS_TIMEOUT=5.0
#NEWS_FALLBACK_ENABLED=True

# Milestone B (semantic attribution) — FinBERT sentiment layer in
# backend/sentiment.py, wired into live anomalies via backend/attribute.py.
#SENTIMENT_ENABLED=true
#SENTIMENT_MODEL=ProsusAI/finbert
# Note: Hugging Face caches model files under HF_HOME. The first real
# FinBERT invocation downloads the (large, several-hundred-MB) model files,
# so expect a one-time slow download; later runs reuse the cache.

# Milestone B (semantic attribution) — background news + sentiment workflow
# in backend/attribute.py, triggered after each live anomaly is broadcast.
#ATTRIBUTION_ENABLED=true
# false = disable news/sentiment attribution and retain Milestone A live behavior.
